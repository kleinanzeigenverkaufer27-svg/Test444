local function fillProgress(duration)
    progressOverlay.Visible = true
    setInteract(false)

    local start = tick()
    local progress = 0

    spawn(function()
        local nextFake = tick() + math.random(5,15)

        while progress < 1 do
            local elapsed = tick() - start
            local target = math.clamp(elapsed/duration,0,1)

            local step = math.random(1,2)/200
            progress = math.min(progress + step, target)

            progressFill.Size = UDim2.new(progress,0,1,0)
            progressLabel.Text = math.floor(progress*100).."%"

            if tick() >= nextFake then
                fakeLabel.Text = fakeTexts[math.random(1,#fakeTexts)]
                nextFake = tick() + math.random(5,15)
            end

            wait(math.random(8,12)/10)
        end

        wait(0.2)
        progressOverlay.Visible = false
        setInteract(true)

        invalidLabel.Text = "Failed to load. Please try again."
        delay(3,function() invalidLabel.Text="" end)
    end)
end

